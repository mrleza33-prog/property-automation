{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node", "@playwright/test"]
    },
    "include": ["features/**/*.ts", "src/**/*.ts", "types/**/*.d.ts", "*.ts"],
    "exclude": ["node_modules"]
}
