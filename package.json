        "dotenv": "^17.2.3",
        "expect": "^30.2.0",
        "multiple-cucumber-html-reporter": "^3.10.0",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.2",
        "why-is-node-running": "^3.2.2"
    }
