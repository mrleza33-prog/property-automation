{
    "name": "property-automation",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "cucumber-js",
        "test:search": "cucumber-js --tags \"@search\"",
        "test:property": "cucumber-js --tags \"@propertySelection\"",
        "test:contacts": "cucumber-js --tags \"@createContact\"",
        "test:contacts:list": "cucumber-js --tags \"@contactsList\"",
        "test:edit-contact": "cucumber-js --tags \"@editContact\"",
        "test:e2e": "cmd /c \"cucumber-js --tags @e2e & node generate-report.js\"",
        "report": "node generate-report.js",
        "test:e2e:report": "cmd /c \"npm run test:e2e & npm run report\""
    },
